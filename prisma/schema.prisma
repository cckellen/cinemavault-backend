datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  username     String?
  avatarUrl    String?  @default("/default-avatar.png")
  isActive     Boolean  @default(true)

  favorites      Favorite[]
  watchlistItems WatchlistItem[]
  sentMessages   Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Movie {
  id          String   @id @default(uuid())
  omdbId      String?  @unique
  title       String
  titleZh     String?
  plot        String?
  genre       String
  year        Int?
  imdbRating  Decimal? @db.Decimal(3, 1)
  posterUrl   String?
  director    String?
  castInfo    String?
  runtime     String?
  isActive    Boolean  @default(true)

  favorites      Favorite[]
  watchlistItems WatchlistItem[]
  messages       Message[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("movies")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  movieId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@map("favorites")
}

model WatchlistItem {
  id        String      @id @default(uuid())
  userId    String
  movieId   String
  status    WatchStatus @default(WATCHLIST)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@map("watchlist_items")
}

model Message {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  movieId    String?
  content    String
  isRead     Boolean  @default(false)

  fromUser User   @relation("SentMessages", fields: [fromUserId], references: [id])
  toUser   User   @relation("ReceivedMessages", fields: [toUserId], references: [id])
  movie    Movie? @relation(fields: [movieId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("messages")
}

enum Role {
  USER
  ADMIN
}

enum WatchStatus {
  WATCHLIST
  WATCHED
}
